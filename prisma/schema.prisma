generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoaImport {
  id          String         @id @default(cuid())
  fileName    String
  recordCount Int
  totalValue  Decimal        @db.Decimal(18, 2)
  createdAt   DateTime       @default(now())
  records     BudgetRecord[]
}

model BudgetRecord {
  id                    BigInt    @id @default(autoincrement())
  importId              String
  import                 LoaImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  organ                  String
  budgetUnit             String
  functionName           String
  subfunction            String
  program                String
  action                  String
  expenseNature           String
  subelement              String
  administrativeProcess   String
  value                   Decimal  @db.Decimal(18, 2)
  createdAt               DateTime @default(now())

  @@index([organ])
  @@index([budgetUnit])
  @@index([functionName])
  @@index([subfunction])
  @@index([program])
  @@index([action])
  @@index([expenseNature])
  @@index([subelement])
  @@index([administrativeProcess])
  @@index([value])
  @@index([importId])
}

model BudgetUnit {
  code String @id
  name String
}

model BudgetOrgan {
  code String @id
  name String
}

enum StatusImportacao {
  PROCESSANDO
  CONCLUIDO
  CONCLUIDO_COM_ALERTAS
  ERRO
  CANCELADO
}

enum TipoImportacaoReceita {
  RECEITA_ARRECADADA
  LDO_RECEITAS
  LOA_RECEITAS
}

model ArquivoImportacao {
  id                  BigInt   @id @default(autoincrement())
  nomeArquivo         String
  tipoArquivo         String?
  tamanhoArquivo      BigInt?
  tipoImportacao      TipoImportacaoReceita @default(RECEITA_ARRECADADA)
  exercicioReferencia Int?
  quantidadeLinhas    Int      @default(0)
  registrosImportados Int      @default(0)
  registrosIgnorados  Int      @default(0)
  registrosComErro    Int      @default(0)
  valorTotalImportado Decimal? @db.Decimal(18, 2)
  status              StatusImportacao @default(PROCESSANDO)
  mensagemErro        String?  @db.Text
  usuarioResponsavel  String?
  iniciadoEm          DateTime @default(now())
  concluidoEm         DateTime?

  receitasArrecadadas ReceitaArrecadada[]
  ldoReceitas         LdoReceita[]
}

model ReceitaArrecadada {
  id                    BigInt   @id @default(autoincrement())

  dataMovimento          DateTime?
  exercicio              Int
  valor                  Decimal  @db.Decimal(18, 2)

  receita                String?
  naturezaReceita        String?
  descricaoReceita       String?
  unidadeOrcamentaria    String?
  codigoFundo            String?
  vinculo                String?

  arquivoImportacaoId    BigInt?
  arquivoImportacao      ArquivoImportacao? @relation(fields: [arquivoImportacaoId], references: [id])

  hashRegistro           String?  @unique
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  @@index([exercicio])
  @@index([dataMovimento])
  @@index([receita])
  @@index([naturezaReceita])
  @@index([unidadeOrcamentaria])
  @@index([codigoFundo])
  @@index([vinculo])
  @@index([arquivoImportacaoId])
}

enum StatusDistribuicaoLdo {
  NAO_INICIADO
  PARCIALMENTE_DISTRIBUIDO
  TOTALMENTE_DISTRIBUIDO
  ACIMA_LDO
}

model LdoReceita {
  id                    BigInt   @id @default(autoincrement())
  exercicio             Int
  numeroLdo             String?  @db.VarChar(100)
  
  // Regra do campo Apelido: alfanumerico obrigatoriamente preservado como string
  apelidoOriginal       String   @db.VarChar(255)
  apelidoNormalizado    String   @db.VarChar(255)

  vinculo               String   @db.VarChar(100)
  descricaoVinculo      String   @db.Text
  valorTotalLdo         Decimal  @db.Decimal(18, 2)

  arquivoImportacaoId   BigInt?
  arquivoImportacao     ArquivoImportacao? @relation(fields: [arquivoImportacaoId], references: [id], onDelete: SetNull)

  linhaOrigem           Int?
  versaoImportacao      Int      @default(1)
  situacaoValidacao     String   @default("VÁLIDO") // VÁLIDO, ALERTA, DUPLICADO, INVALIDO
  mensagemValidacao     String?  @db.Text

  statusDistribuicao    StatusDistribuicaoLdo @default(NAO_INICIADO)
  valorDistribuidoLoa   Decimal  @default(0) @db.Decimal(18, 2)
  saldoDistribuir       Decimal  @default(0) @db.Decimal(18, 2)
  observacoes           String?  @db.Text

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@index([exercicio])
  @@index([apelidoNormalizado])
  @@index([vinculo])
  @@index([arquivoImportacaoId])
  @@index([statusDistribuicao])
}

model IniciativaEstrategica {
  id              BigInt   @id @default(autoincrement())
  secretaria      String   @db.VarChar(255)
  unidade         String?  @db.VarChar(100)
  funcao          String?  @db.VarChar(100)
  subfuncao       String?  @db.VarChar(100)
  programa        String?  @db.VarChar(100)
  acao            String   @db.VarChar(100)
  despesa         String?  @db.VarChar(100)
  programaticaLdo String   @db.VarChar(255)
  dsIniciativa    String   @db.Text
  vinculo         String   @db.VarChar(100)
  valorFinalPldo27 Decimal  @db.Decimal(18, 2)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([secretaria])
  @@index([unidade])
  @@index([funcao])
  @@index([subfuncao])
  @@index([programa])
  @@index([acao])
  @@index([despesa])
  @@index([programaticaLdo])
  @@index([dsIniciativa])
  @@index([vinculo])
}

model NomenclaturaDespesa {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique @db.VarChar(50)
  codigoFormatado String   @db.VarChar(50)
  descricao       String   @db.VarChar(255)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([codigo])
  @@index([codigoFormatado])
}

enum StatusEnquadramentoLdo {
  PENDENTE
  PARCIAL
  CONCLUIDO
}

model LdoAcaoImportacao {
  id             String    @id @default(cuid())
  nomeArquivo    String
  exercicio      Int
  quantidade     Int
  valorTotal     Decimal   @db.Decimal(18, 2)
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  acoes          LdoAcao[]

  @@index([exercicio, ativo])
}

model LdoAcao {
  id              String                 @id @default(cuid())
  importacaoId    String
  importacao      LdoAcaoImportacao      @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  exercicio       Int
  secretaria      String                 @db.VarChar(255)
  programaCodigo  String?                @db.VarChar(50)
  programaNome    String                 @db.VarChar(255)
  funcaoCodigo    String?                @db.VarChar(50)
  funcaoNome      String?                @db.VarChar(255)
  subfuncaoCodigo String?                @db.VarChar(50)
  subfuncaoNome   String?                @db.VarChar(255)
  acaoCodigo      String                 @db.VarChar(50)
  acaoNome        String?                @db.VarChar(255)
  produto         String                 @db.Text
  metaFisica      Decimal?               @db.Decimal(18, 2)
  custoFinanceiro Decimal                @db.Decimal(18, 2)
  linhaOrigem     Int?
  criadoEm        DateTime               @default(now())
  enquadramentos  EnquadramentoLdoLoa[]

  @@index([exercicio, secretaria])
  @@index([acaoCodigo])
  @@index([importacaoId])
}

model CodigoAuxiliarImportacao {
  id          String           @id @default(cuid())
  nomeArquivo String
  exercicio   Int
  versao      String?          @db.VarChar(50)
  quantidade  Int
  ativo       Boolean          @default(true)
  criadoEm    DateTime         @default(now())
  codigos     CodigoAuxiliar[]

  @@index([exercicio, ativo])
}

model CodigoAuxiliar {
  id             String                    @id @default(cuid())
  importacaoId   String
  importacao     CodigoAuxiliarImportacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  exercicio      Int
  tipo           String                    @db.VarChar(100)
  abaOrigem      String                    @db.VarChar(150)
  codigo         String                    @db.VarChar(100)
  nome           String                    @db.Text
  especificacao  String?                   @db.Text
  observacao     String?                   @db.Text
  metadados      Json?
  ativo          Boolean                   @default(true)
  criadoEm       DateTime                  @default(now())
  enquadramentosDespesa EnquadramentoLdoLoa[] @relation("DespesaEnquadramento")
  enquadramentosFonte   EnquadramentoLdoLoa[] @relation("FonteEnquadramento")
  enquadramentosAplicacao EnquadramentoLdoLoa[] @relation("AplicacaoEnquadramento")

  @@unique([importacaoId, tipo, codigo])
  @@index([exercicio, tipo, ativo])
  @@index([codigo])
}

model EnquadramentoLdoLoa {
  id                  String          @id @default(cuid())
  ldoAcaoId           String
  ldoAcao             LdoAcao         @relation(fields: [ldoAcaoId], references: [id], onDelete: Cascade)
  despesaId           String
  despesa             CodigoAuxiliar  @relation("DespesaEnquadramento", fields: [despesaId], references: [id])
  fonteRecursoId       String
  fonteRecurso         CodigoAuxiliar  @relation("FonteEnquadramento", fields: [fonteRecursoId], references: [id])
  codigoAplicacaoId    String
  codigoAplicacao      CodigoAuxiliar  @relation("AplicacaoEnquadramento", fields: [codigoAplicacaoId], references: [id])
  valor               Decimal         @db.Decimal(18, 2)
  justificativa       String?         @db.Text
  motivoSugestao      String?         @db.Text
  responsavel         String?         @db.VarChar(255)
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  removidoEm          DateTime?

  @@index([ldoAcaoId, removidoEm])
  @@index([despesaId])
  @@index([fonteRecursoId])
  @@index([codigoAplicacaoId])
}

model PainelConfig {
  id           String   @id
  chave        String   @unique
  valor        Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([chave])
}
