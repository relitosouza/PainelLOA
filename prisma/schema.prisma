generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoaImport {
  id          String         @id @default(cuid())
  fileName    String
  recordCount Int
  totalValue  Decimal        @db.Decimal(18, 2)
  createdAt   DateTime       @default(now())
  records     BudgetRecord[]
  Contract    Contract[]
}

model BudgetRecord {
  id                    BigInt    @id @default(autoincrement())
  importId              String
  organ                 String
  budgetUnit            String
  functionName          String
  subfunction           String
  program               String
  action                String
  expenseNature         String
  subelement            String
  administrativeProcess String
  value                 Decimal   @db.Decimal(18, 2)
  createdAt             DateTime  @default(now())
  apelido               String?
  contrato              String?
  fonteRecurso          String?
  tipoAcao              String?
  import                LoaImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([organ])
  @@index([budgetUnit])
  @@index([functionName])
  @@index([subfunction])
  @@index([program])
  @@index([action])
  @@index([expenseNature])
  @@index([subelement])
  @@index([administrativeProcess])
  @@index([value])
  @@index([importId])
  @@index([organ, program, action])
  @@index([expenseNature, subelement])
}

model BudgetUnit {
  code String @id
  name String
}

model BudgetOrgan {
  code String @id
  name String
}

model ArquivoImportacao {
  id                  BigInt                @id @default(autoincrement())
  nomeArquivo         String
  tipoArquivo         String?
  tamanhoArquivo      BigInt?
  exercicioReferencia Int?
  quantidadeLinhas    Int                   @default(0)
  registrosImportados Int                   @default(0)
  registrosIgnorados  Int                   @default(0)
  registrosComErro    Int                   @default(0)
  status              StatusImportacao      @default(PROCESSANDO)
  mensagemErro        String?
  usuarioResponsavel  String?
  iniciadoEm          DateTime              @default(now())
  concluidoEm         DateTime?
  tipoImportacao      TipoImportacaoReceita @default(RECEITA_ARRECADADA)
  valorTotalImportado Decimal?              @db.Decimal(18, 2)
  ldoReceitas         LdoReceita[]
  receitasArrecadadas ReceitaArrecadada[]
}

model ReceitaArrecadada {
  id                  BigInt             @id @default(autoincrement())
  dataMovimento       DateTime?
  exercicio           Int
  valor               Decimal            @db.Decimal(18, 2)
  receita             String?
  naturezaReceita     String?
  descricaoReceita    String?
  unidadeOrcamentaria String?
  codigoFundo         String?
  vinculo             String?
  arquivoImportacaoId BigInt?
  hashRegistro        String?            @unique
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
  arquivoImportacao   ArquivoImportacao? @relation(fields: [arquivoImportacaoId], references: [id])

  @@index([exercicio])
  @@index([dataMovimento])
  @@index([receita])
  @@index([naturezaReceita])
  @@index([unidadeOrcamentaria])
  @@index([codigoFundo])
  @@index([vinculo])
  @@index([arquivoImportacaoId])
}

model LdoReceita {
  id                  BigInt                @id @default(autoincrement())
  exercicio           Int
  numeroLdo           String?               @db.VarChar(100)
  apelidoOriginal     String                @db.VarChar(255)
  apelidoNormalizado  String                @db.VarChar(255)
  vinculo             String                @db.VarChar(100)
  descricaoVinculo    String
  valorTotalLdo       Decimal               @db.Decimal(18, 2)
  arquivoImportacaoId BigInt?
  linhaOrigem         Int?
  versaoImportacao    Int                   @default(1)
  situacaoValidacao   String                @default("VÁLIDO")
  mensagemValidacao   String?
  statusDistribuicao  StatusDistribuicaoLdo @default(NAO_INICIADO)
  valorDistribuidoLoa Decimal               @default(0) @db.Decimal(18, 2)
  saldoDistribuir     Decimal               @default(0) @db.Decimal(18, 2)
  observacoes         String?
  criadoEm            DateTime              @default(now())
  atualizadoEm        DateTime              @updatedAt
  arquivoImportacao   ArquivoImportacao?    @relation(fields: [arquivoImportacaoId], references: [id])

  @@index([exercicio])
  @@index([apelidoNormalizado])
  @@index([vinculo])
  @@index([arquivoImportacaoId])
  @@index([statusDistribuicao])
}

model IniciativaEstrategica {
  id               BigInt   @id @default(autoincrement())
  secretaria       String   @db.VarChar(255)
  programaticaLdo  String   @db.VarChar(255)
  dsIniciativa     String
  acao             String   @db.VarChar(100)
  vinculo          String   @db.VarChar(100)
  valorFinalPldo27 Decimal  @db.Decimal(18, 2)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
  despesa          String?  @db.VarChar(100)
  funcao           String?  @db.VarChar(100)
  programa         String?  @db.VarChar(100)
  subfuncao        String?  @db.VarChar(100)
  unidade          String?  @db.VarChar(100)

  @@index([secretaria])
  @@index([unidade])
  @@index([funcao])
  @@index([subfuncao])
  @@index([programa])
  @@index([acao])
  @@index([despesa])
  @@index([programaticaLdo])
  @@index([dsIniciativa])
  @@index([vinculo])
  @@index([secretaria, programa, acao])
  @@index([despesa, vinculo])
}

model NomenclaturaDespesa {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique @db.VarChar(50)
  codigoFormatado String   @db.VarChar(50)
  descricao       String   @db.VarChar(255)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([codigo])
  @@index([codigoFormatado])
}

model LdoAcaoImportacao {
  id          String    @id @default(cuid())
  nomeArquivo String
  exercicio   Int
  quantidade  Int
  valorTotal  Decimal   @db.Decimal(18, 2)
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  acoes       LdoAcao[]

  @@index([exercicio, ativo])
}

model LdoAcao {
  id              String                @id @default(cuid())
  importacaoId    String
  exercicio       Int
  secretaria      String                @db.VarChar(255)
  programaCodigo  String?               @db.VarChar(50)
  programaNome    String                @db.VarChar(255)
  acaoCodigo      String                @db.VarChar(50)
  acaoNome        String?               @db.VarChar(255)
  produto         String
  metaFisica      Decimal?              @db.Decimal(18, 2)
  custoFinanceiro Decimal               @db.Decimal(18, 2)
  linhaOrigem     Int?
  criadoEm        DateTime              @default(now())
  funcaoCodigo    String?               @db.VarChar(50)
  funcaoNome      String?               @db.VarChar(255)
  subfuncaoCodigo String?               @db.VarChar(50)
  subfuncaoNome   String?               @db.VarChar(255)
  enquadramentos  EnquadramentoLdoLoa[]
  importacao      LdoAcaoImportacao     @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([exercicio, secretaria])
  @@index([acaoCodigo])
  @@index([importacaoId])
}

model CodigoAuxiliarImportacao {
  id          String           @id @default(cuid())
  nomeArquivo String
  exercicio   Int
  versao      String?          @db.VarChar(50)
  quantidade  Int
  ativo       Boolean          @default(true)
  criadoEm    DateTime         @default(now())
  codigos     CodigoAuxiliar[]

  @@index([exercicio, ativo])
}

model CodigoAuxiliar {
  id                      String                   @id @default(cuid())
  importacaoId            String
  exercicio               Int
  tipo                    String                   @db.VarChar(100)
  abaOrigem               String                   @db.VarChar(150)
  codigo                  String                   @db.VarChar(100)
  nome                    String
  especificacao           String?
  observacao              String?
  metadados               Json?
  ativo                   Boolean                  @default(true)
  criadoEm                DateTime                 @default(now())
  importacao              CodigoAuxiliarImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  enquadramentosAplicacao EnquadramentoLdoLoa[]    @relation("AplicacaoEnquadramento")
  enquadramentosDespesa   EnquadramentoLdoLoa[]    @relation("DespesaEnquadramento")
  enquadramentosFonte     EnquadramentoLdoLoa[]    @relation("FonteEnquadramento")

  @@unique([importacaoId, tipo, codigo])
  @@index([exercicio, tipo, ativo])
  @@index([codigo])
}

model EnquadramentoLdoLoa {
  id                String         @id @default(cuid())
  ldoAcaoId         String
  despesaId         String
  fonteRecursoId    String
  codigoAplicacaoId String
  valor             Decimal        @db.Decimal(18, 2)
  justificativa     String?
  motivoSugestao    String?
  responsavel       String?        @db.VarChar(255)
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt
  removidoEm        DateTime?
  codigoAplicacao   CodigoAuxiliar @relation("AplicacaoEnquadramento", fields: [codigoAplicacaoId], references: [id])
  despesa           CodigoAuxiliar @relation("DespesaEnquadramento", fields: [despesaId], references: [id])
  fonteRecurso      CodigoAuxiliar @relation("FonteEnquadramento", fields: [fonteRecursoId], references: [id])
  ldoAcao           LdoAcao        @relation(fields: [ldoAcaoId], references: [id], onDelete: Cascade)

  @@index([ldoAcaoId, removidoEm])
  @@index([despesaId])
  @@index([fonteRecursoId])
  @@index([codigoAplicacaoId])
}

model PainelConfig {
  id           String   @id
  chave        String   @unique
  valor        Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([chave])
}

model SubelementoCustomizado {
  id              String   @id
  groupKey        String?  @db.VarChar(255)
  secretaria      String   @db.VarChar(255)
  programa        String   @db.VarChar(255)
  acao            String   @db.VarChar(255)
  natureza        String   @db.VarChar(255)
  elemento        String   @db.VarChar(100)
  subelemento     String
  fonteVinculo    String   @db.VarChar(100)
  codigoAplicacao String?  @db.VarChar(100)
  processo        String?  @db.VarChar(255)
  projetoIniciado String?  @db.VarChar(50)
  observacao      String?
  valLoa          Decimal  @default(0) @db.Decimal(18, 2)
  valLdo          Decimal  @default(0) @db.Decimal(18, 2)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([secretaria, programa, acao])
  @@index([natureza])
  @@index([fonteVinculo])
}

model Contract {
  id                     BigInt    @id @default(autoincrement())
  importId               String
  secretaria             String?
  fornecedor             String?
  apelidoDespesa         String?
  contratoPasta          String?
  processoAdministrativo String?
  valorContratual        Decimal?  @db.Decimal(18, 2)
  inicioContrato         DateTime?
  vencimentoContrato     DateTime?
  fonteClassificacao     String?
  classificacao          String?
  qtdProgramaticas       Int?
  reajuste               String?
  conferido              String?
  mesesContrato          Int?
  mesesRestantes         Int?
  valor12Meses           Decimal?  @db.Decimal(18, 2)
  loaProposta            Decimal?  @db.Decimal(18, 2)
  vinculo                String?
  quantidadePA           Int?
  diferenca              Decimal?  @db.Decimal(18, 2)
  LoaImport              LoaImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([fornecedor])
  @@index([importId])
  @@index([secretaria])
}

enum StatusImportacao {
  PROCESSANDO
  CONCLUIDO
  CONCLUIDO_COM_ALERTAS
  ERRO
  CANCELADO
}

enum TipoImportacaoReceita {
  RECEITA_ARRECADADA
  LDO_RECEITAS
  LOA_RECEITAS
}

enum StatusDistribuicaoLdo {
  NAO_INICIADO
  PARCIALMENTE_DISTRIBUIDO
  TOTALMENTE_DISTRIBUIDO
  ACIMA_LDO
}

enum StatusEnquadramentoLdo {
  PENDENTE
  PARCIAL
  CONCLUIDO
}

enum PapelUsuario {
  ADMIN
  PLANEJAMENTO
  TECNICO_SECRETARIA
  LEITURA
}

enum StatusAlteracaoOrcamentaria {
  APLICADA
  PENDENTE_APROVACAO
  REJEITADA
  REVERTIDA
}

model Usuario {
  id                   String                 @id @default(cuid())
  nome                 String                 @db.VarChar(255)
  email                String                 @unique @db.VarChar(255)
  senhaHash            String?                @db.VarChar(255)
  papel                PapelUsuario           @default(TECNICO_SECRETARIA)
  ativo                Boolean                @default(true)
  secretaria           String?                @db.VarChar(255)
  codigoSecretaria     String?                @db.VarChar(50)
  cargo                String?                @db.VarChar(150)
  telefone             String?                @db.VarChar(50)
  ultimoAcesso         DateTime?
  criadoEm             DateTime               @default(now())
  atualizadoEm         DateTime               @updatedAt
  alteracoesRealizadas AlteracaoOrcamentaria[]
  exclusoesRealizadas  ExclusaoDotacao[]

  @@index([email])
  @@index([codigoSecretaria])
  @@index([papel])
}

model AlteracaoOrcamentaria {
  id                  BigInt                      @id @default(autoincrement())
  dotacaoId           String?
  exercicio           Int                         @default(2027)
  secretaria          String                      @db.VarChar(255)
  codigoSecretaria    String?                     @db.VarChar(50)
  programa            String?
  acao                String?
  natureza            String?                     @db.VarChar(255)
  subelemento         String?
  processo            String?                     @db.VarChar(255)
  apelido             String?                     @db.VarChar(255)
  valorAnterior       Decimal                     @db.Decimal(18, 2)
  valorNovo           Decimal                     @db.Decimal(18, 2)
  diferenca           Decimal                     @db.Decimal(18, 2)
  justificativa       String
  tipoAlteracao       String                      @default("AJUSTE_VALOR") @db.VarChar(50)
  status              StatusAlteracaoOrcamentaria @default(APLICADA)
  usuarioId           String?
  nomeOperador        String                      @db.VarChar(255)
  emailOperador       String?                     @db.VarChar(255)
  criadoEm            DateTime                    @default(now())
  revertidoEm         DateTime?
  usuarioReversao     String?                     @db.VarChar(255)
  usuario             Usuario?                    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([secretaria])
  @@index([codigoSecretaria])
  @@index([exercicio])
  @@index([dotacaoId])
  @@index([criadoEm])
  @@index([usuarioId])
}

model ExclusaoDotacao {
  id               BigInt    @id @default(autoincrement())
  dotacaoId        String
  exercicio        Int       @default(2027)
  secretaria       String    @db.VarChar(255)
  codigoSecretaria String?   @db.VarChar(50)
  programa         String?
  acao             String?
  natureza         String?   @db.VarChar(255)
  subelemento      String?
  processo         String?   @db.VarChar(255)
  apelido          String?   @db.VarChar(255)
  valorOriginal    Decimal   @db.Decimal(18, 2)
  dadosOriginais   Json?
  motivoExclusao   String
  restaurado       Boolean   @default(false)
  restauradoEm     DateTime?
  usuarioId        String?
  nomeOperador     String    @db.VarChar(255)
  emailOperador    String?   @db.VarChar(255)
  criadoEm         DateTime  @default(now())
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([secretaria])
  @@index([codigoSecretaria])
  @@index([exercicio])
  @@index([dotacaoId])
  @@index([criadoEm])
  @@index([usuarioId])
}
